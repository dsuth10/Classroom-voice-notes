# Classroom Voice Notes local environment configuration
# Copy this file to ".env". The repository already ignores that file.

# Current broker development and verification is staging-only.
# This value is case-sensitive and must be exactly "staging".
CVN_BROKER_ENV=staging

# Never store broker bearer tokens, HMAC secrets or key IDs in this file.
# Use the operating-system credential store; see:
# docs/operations/environment-and-credentials.md

# Legacy Picovoice support. The default wake-word engine is openWakeWord.
PORCUPINE_ACCESS_KEY=your_access_key_here
